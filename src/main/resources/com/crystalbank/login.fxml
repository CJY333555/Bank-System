<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.crystalbank.controller.LoginController"
      styleClass="root-container"
      alignment="CENTER" spacing="0"
      prefWidth="420" prefHeight="520">

    <!-- Header -->
    <VBox styleClass="header-box" alignment="CENTER" spacing="4">
        <Text text="💎 CrystalBank" styleClass="bank-title"/>
        <Text text="Your Trusted Banking Partner" styleClass="bank-subtitle"/>
    </VBox>

    <!-- Card -->
    <VBox styleClass="card" alignment="CENTER" spacing="16"
          maxWidth="340">

        <Text text="Sign In" styleClass="card-title"/>

        <VBox spacing="6">
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField" promptText="Enter your username"
                       styleClass="text-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password"
                           styleClass="text-field"/>
        </VBox>

        <Label fx:id="messageLabel" text="" wrapText="true"
               maxWidth="300" styleClass="message-label"/>

        <Button text="Login" onAction="#handleLogin"
                styleClass="btn-primary" maxWidth="Infinity"/>

        <HBox alignment="CENTER" spacing="6">
            <Label text="Don't have an account?" styleClass="hint-label"/>
            <Hyperlink text="Register here" onAction="#handleGoRegister"
                       styleClass="link"/>
        </HBox>

    </VBox>
</VBox>
