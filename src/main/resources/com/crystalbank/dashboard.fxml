<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.crystalbank.controller.DashboardController"
      styleClass="root-container"
      spacing="0" prefWidth="750" prefHeight="560">

    <!-- Top bar -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
        <Text text="💎 CrystalBank" styleClass="topbar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel" styleClass="topbar-welcome"/>
        <Button text="Logout" onAction="#handleLogout" styleClass="btn-logout"/>
    </HBox>

    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- Sidebar -->
        <VBox styleClass="sidebar" spacing="8" prefWidth="180">
            <Text text="Menu" styleClass="sidebar-title"/>
            <Button text="🏠  Dashboard"      styleClass="sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="💰  Deposit"         onAction="#handleDeposit"  styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="💸  Withdraw"        onAction="#handleWithdraw" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🔄  Transfer"        onAction="#handleTransfer" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="📋  History"         onAction="#handleHistory"  styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>

        <!-- Main content -->
        <VBox styleClass="main-content" spacing="20" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

            <Text text="Account Overview" styleClass="page-title"/>

            <!-- Account info cards -->
            <HBox spacing="16">
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="ACCOUNT NUMBER" styleClass="info-card-label"/>
                    <Label fx:id="accountNumberLabel" styleClass="info-card-value"/>
                </VBox>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="ACCOUNT TYPE" styleClass="info-card-label"/>
                    <Label fx:id="accountTypeLabel" styleClass="info-card-value"/>
                </VBox>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="STATUS" styleClass="info-card-label"/>
                    <Label fx:id="statusLabel" styleClass="info-card-value"/>
                </VBox>
            </HBox>

            <!-- Balance card -->
            <VBox styleClass="balance-card" alignment="CENTER" spacing="8">
                <Label text="Available Balance" styleClass="balance-label"/>
                <Label fx:id="balanceLabel" styleClass="balance-amount"/>
            </VBox>

            <!-- Quick action buttons -->
            <Text text="Quick Actions" styleClass="section-title"/>
            <HBox spacing="12">
                <Button text="💰 Deposit"   onAction="#handleDeposit"  styleClass="btn-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="💸 Withdraw"  onAction="#handleWithdraw" styleClass="btn-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="🔄 Transfer"  onAction="#handleTransfer" styleClass="btn-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="📋 History"   onAction="#handleHistory"  styleClass="btn-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

        </VBox>
    </HBox>
</VBox>
